@name fold: (u + 1) nsw+ k becomes u + (k + 1) without nsw, as u + 1 may wrap, so the lanes stay scalar
@passes fold slp

@input
func plain(ptr, i32, i32) -> void {
	v0 = start : (ctrl, mem, ptr, i32, i32)
	v1 = stop : ctrl v33
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "p" of v0
	v5 = proj : i32  #3 "u" of v0
	v6 = proj : i32  #4 "v" of v0
	v8 = const : i64  2
	v12 = const : i32  1
	v19 = const : i32  2
	v26 = const : i32  3
	v34 = add : i32 v5, v12
	v7 = sext : i64 v34
	v9 = shl : i64 v7, v8
	v10 = add : ptr v4, v9
	v11 = store : mem v2, v3, v10, v6
	v13 = add : i32  nsw v34, v12
	v14 = sext : i64 v13
	v15 = shl : i64 v14, v8
	v17 = add : ptr v4, v15
	v18 = store : mem v2, v11, v17, v6
	v20 = add : i32  nsw v34, v19
	v21 = sext : i64 v20
	v22 = shl : i64 v21, v8
	v24 = add : ptr v4, v22
	v25 = store : mem v2, v18, v24, v6
	v27 = add : i32  nsw v34, v26
	v28 = sext : i64 v27
	v29 = shl : i64 v28, v8
	v31 = add : ptr v4, v29
	v32 = store : mem v2, v25, v31, v6
	v33 = return : ctrl v2, v32
}

func flagged(ptr, i32, i32) -> void {
	v0 = start : (ctrl, mem, ptr, i32, i32)
	v1 = stop : ctrl v33
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "p" of v0
	v5 = proj : i32  #3 "u" of v0
	v6 = proj : i32  #4 "v" of v0
	v8 = const : i64  2
	v12 = const : i32  1
	v19 = const : i32  2
	v26 = const : i32  3
	v34 = add : i32  nsw v5, v12
	v7 = sext : i64 v34
	v9 = shl : i64 v7, v8
	v10 = add : ptr v4, v9
	v11 = store : mem v2, v3, v10, v6
	v13 = add : i32  nsw v34, v12
	v14 = sext : i64 v13
	v15 = shl : i64 v14, v8
	v17 = add : ptr v4, v15
	v18 = store : mem v2, v11, v17, v6
	v20 = add : i32  nsw v34, v19
	v21 = sext : i64 v20
	v22 = shl : i64 v21, v8
	v24 = add : ptr v4, v22
	v25 = store : mem v2, v18, v24, v6
	v27 = add : i32  nsw v34, v26
	v28 = sext : i64 v27
	v29 = shl : i64 v28, v8
	v31 = add : ptr v4, v29
	v32 = store : mem v2, v25, v31, v6
	v33 = return : ctrl v2, v32
}

@expect
