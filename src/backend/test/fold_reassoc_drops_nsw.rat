func flagged(ptr, i32, i32) -> void {
  v0 = start : (ctrl, mem, ptr, i32, i32)
  v1 = stop : ctrl v31
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "p" of v0
  v5 = proj : i32  #3 "u" of v0
  v6 = proj : i32  #4 "v" of v0
  v7 = const : i64  2
  v8 = const : i32  1
  v11 = add : i32  nsw v5, v8
  v12 = sext : i64 v11
  v13 = shl : i64 v12, v7
  v14 = add : ptr v4, v13
  v31 = return : ctrl v2, v40
  v39 = splat : <4 x i32> v6
  v40 = store : mem v2, v3, v14, v39
}
