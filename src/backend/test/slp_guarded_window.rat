	v1 = stop : ctrl v40
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "c" of v0
	v5 = proj : ptr  #3 "a" of v0
	v6 = const : i64  4
	v7 = const : i64  8
	v8 = const : i64  12
	v10 = add : ptr v4, v6
	v11 = add : ptr v4, v7
	v12 = add : ptr v4, v8
	v13 = add : ptr v5, v6
	v14 = add : ptr v5, v7
	v15 = add : ptr v5, v8
	v16 = load : i32 v2, v3, v5
	v17 = add : i32 v16, v16
	v18 = store : mem v2, v3, v4, v17
	v19 = load : i32 v2, v18, v13
	v20 = add : i32 v19, v19
	v21 = store : mem v2, v18, v10, v20
	v22 = load : i32 v2, v21, v14
	v23 = add : i32 v22, v22
	v24 = store : mem v2, v21, v11, v23
	v25 = load : i32 v2, v24, v15
	v26 = add : i32 v25, v25
	v27 = store : mem v2, v24, v12, v26
	v40 = return : ctrl v2, v27
}

