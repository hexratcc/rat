@name slp: a float pair whose loads a call follows stays scalar, its vectors may spill around the call
@passes slp

@input
func f(ptr, ptr) -> f32 {
	v0 = start : (ctrl, mem, ptr, ptr)
	v1 = stop : ctrl v40
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "a" of v0
	v5 = proj : ptr  #3 "b" of v0
	v6 = const : i64  4
	v11 = load : f32 v2, v3, v4
	v17 = load : f32 v2, v3, v5
	v18 = fmul : f32 v11, v17
	v23 = add : ptr v4, v6
	v24 = load : f32 v2, v3, v23
	v29 = add : ptr v5, v6
	v30 = load : f32 v2, v3, v29
	v31 = fmul : f32 v24, v30
	v32 = fsub : f32 v18, v31
	v37 = call : (ctrl, mem)  "g" v2, v3
	v38 = proj : ctrl  #0 "ctrl" of v37
	v39 = proj : mem  #1 "mem" of v37
	v40 = return : ctrl v38, v39, v32
}

@expect
func f(ptr, ptr) -> f32 {
	v0 = start : (ctrl, mem, ptr, ptr)
	v1 = stop : ctrl v40
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "a" of v0
	v5 = proj : ptr  #3 "b" of v0
	v6 = const : i64  4
	v11 = load : f32 v2, v3, v4
	v17 = load : f32 v2, v3, v5
	v18 = fmul : f32 v11, v17
	v23 = add : ptr v4, v6
	v24 = load : f32 v2, v3, v23
	v29 = add : ptr v5, v6
	v30 = load : f32 v2, v3, v29
	v31 = fmul : f32 v24, v30
	v32 = fsub : f32 v18, v31
	v37 = call : (ctrl, mem)  "g" v2, v3
	v38 = proj : ctrl  #0 "ctrl" of v37
	v39 = proj : mem  #1 "mem" of v37
	v40 = return : ctrl v38, v39, v32
}
