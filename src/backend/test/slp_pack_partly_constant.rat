@name slp: a build vector of variable and constant lanes costs an insert per variable lane and a constant base, which a lane 0 into zeros does not need, so one variable among zero lanes stores as one vector
@passes loadcanon slp

@input
func t(ptr restrict, ptr restrict, ptr restrict, i32, f32) -> void {
  v0 = start : (ctrl, mem, ptr, ptr, ptr, i32, f32)
  v1 = stop : ctrl v76
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "arg0" of v0
  v5 = proj : ptr  #3 "arg1" of v0
  v6 = proj : ptr  #4 "arg2" of v0
  v7 = proj : i32  #5 "arg3" of v0
