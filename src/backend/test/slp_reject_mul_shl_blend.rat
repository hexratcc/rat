@name slp: a mul and a shl lane do not blend, so the window stays scalar
@passes slp

@input
func t(ptr restrict, ptr restrict) -> void {
	v0 = start : (ctrl, mem, ptr, ptr)
	v1 = stop : ctrl v40
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "c" of v0
	v5 = proj : ptr  #3 "a" of v0
	v6 = const : i32  3
	v7 = const : i64  4
	v8 = const : i64  8
	v9 = const : i64  12
	v10 = add : ptr v4, v7
	v11 = add : ptr v4, v8
	v12 = add : ptr v4, v9
	v13 = add : ptr v5, v7
	v14 = add : ptr v5, v8
	v15 = add : ptr v5, v9
	v20 = load : i32 v2, v3, v5
	v21 = load : i32 v2, v3, v13
	v22 = load : i32 v2, v3, v14
	v23 = load : i32 v2, v3, v15
	v28 = mul : i32 v20, v6
	v29 = shl : i32 v21, v6
	v30 = mul : i32 v22, v6
	v31 = shl : i32 v23, v6
	v32 = store : mem v2, v3, v4, v28
	v33 = store : mem v2, v32, v10, v29
	v34 = store : mem v2, v33, v11, v30
	v35 = store : mem v2, v34, v12, v31
	v40 = return : ctrl v2, v35
}

@expect
func t(ptr restrict, ptr restrict) -> void {
  v0 = start : (ctrl, mem, ptr, ptr)
  v1 = stop : ctrl v28
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "c" of v0
  v5 = proj : ptr  #3 "a" of v0
  v6 = const : i32  3
  v7 = const : i64  4
  v8 = const : i64  8
  v9 = const : i64  12
  v10 = add : ptr v4, v7
  v11 = add : ptr v4, v8
  v12 = add : ptr v4, v9
  v13 = add : ptr v5, v7
  v14 = add : ptr v5, v8
  v15 = add : ptr v5, v9
  v16 = load : i32 v2, v3, v5
  v17 = load : i32 v2, v3, v13
  v18 = load : i32 v2, v3, v14
  v19 = load : i32 v2, v3, v15
  v20 = mul : i32 v16, v6
  v21 = shl : i32 v17, v6
  v22 = mul : i32 v18, v6
  v23 = shl : i32 v19, v6
  v24 = store : mem v2, v3, v4, v20
  v25 = store : mem v2, v24, v10, v21
  v26 = store : mem v2, v25, v11, v22
  v27 = store : mem v2, v26, v12, v23
  v28 = return : ctrl v2, v27
}
