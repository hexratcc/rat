@name inline: a sqrtf call the module does not define becomes fsqrt, a module fabs is still inlined, a sqrt of an f32 stays a call
@passes inline

@input
func fabs(f64) -> f64 {
	v0 = start : (ctrl, mem, f64)
	v1 = stop : ctrl v6
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : f64  #2 "arg0" of v0
	v5 = fneg : f64 v4
	v6 = return : ctrl v2, v3, v5
}

func caller(f32, f64) -> f64 {
	v0 = start : (ctrl, mem, f32, f64)
	v1 = stop : ctrl v19
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : f32  #2 "arg0" of v0
	v5 = proj : f64  #3 "arg1" of v0
	v6 = call : (ctrl, mem, f32) "sqrtf" v2, v3, v4
	v7 = proj : ctrl  #0 "ctrl" of v6
	v8 = proj : mem  #1 "mem" of v6
	v9 = proj : f32  #2 "ret" of v6
	v10 = fpext : f64 v9
	v11 = call : (ctrl, mem, f64) "fabs" v7, v8, v10
	v12 = proj : ctrl  #0 "ctrl" of v11
	v13 = proj : mem  #1 "mem" of v11
	v14 = proj : f64  #2 "ret" of v11
	v15 = call : (ctrl, mem, f64) "sqrt" v12, v13, v4
	v16 = proj : ctrl  #0 "ctrl" of v15
	v17 = proj : mem  #1 "mem" of v15
	v18 = proj : f64  #2 "ret" of v15
	v20 = fadd : f64 v14, v18
	v19 = return : ctrl v16, v17, v20
}

@expect
func fabs(f64) -> f64 {
  v0 = start : (ctrl, mem, f64)
  v1 = stop : ctrl v6
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : f64  #2 "arg0" of v0
  v5 = fneg : f64 v4
  v6 = return : ctrl v2, v3, v5
}

func caller(f32, f64) -> f64 {
  v0 = start : (ctrl, mem, f32, f64)
  v1 = stop : ctrl v13
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : f32  #2 "arg0" of v0
  v5 = call : (ctrl, mem, f64)  "sqrt" v2, v3, v4
  v6 = proj : ctrl  #0 "ctrl" of v5
  v7 = proj : mem  #1 "mem" of v5
  v8 = proj : f64  #2 "ret" of v5
  v9 = fsqrt : f32 v4
  v10 = fpext : f64 v9
  v11 = fneg : f64 v10
  v12 = fadd : f64 v11, v8
  v13 = return : ctrl v6, v7, v12
}
