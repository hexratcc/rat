@name strengthreduce: an i64 IV scaled by 4 stays for x86 addressing, a scale of 12 is reduced
@passes strengthreduce

@input
var a : [4096 x i32] = ""

func f() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v24
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = const : i64  0
	v5 = region : ctrl  loop v2, v10
	v6 = phi : i64 v5, v4, v23
	v7 = const : i64  1000
	v8 = slt : i1 v6, v7
	v9 = if : (ctrl, ctrl) v5, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "a"
	v13 = const : i64  2
	v14 = shl : i64 v6, v13
	v15 = add : ptr v12, v14
	v16 = const : i64  12
	v17 = mul : i64 v6, v16
	v18 = add : ptr v12, v17
	v19 = phi : mem v5, v3, v21
	v20 = load : i32 v10, v19, v18
	v21 = store : mem v10, v19, v15, v20
	v22 = const : i64  1
	v23 = add : i64 v6, v22
	v24 = return : ctrl v11, v19
}

@expect
var a : [4096 x i32] = ""

func f() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v24
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = const : i64  0
	v5 = region : ctrl  loop v2, v10
	v6 = phi : i64 v5, v4, v23
	v7 = const : i64  1000
	v8 = slt : i1 v6, v7
	v9 = if : (ctrl, ctrl) v5, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "a"
	v13 = const : i64  2
	v14 = shl : i64 v6, v13
	v15 = add : ptr v12, v14
	v18 = add : ptr v12, v27
	v19 = phi : mem v5, v3, v21
	v20 = load : i32 v10, v19, v18
	v21 = store : mem v10, v19, v15, v20
	v22 = const : i64  1
	v23 = add : i64 v6, v22
	v24 = return : ctrl v11, v19
	v25 = const : i64  12
	v26 = mul : i64 v4, v25
	v27 = phi : i64 v5, v26, v29
	v28 = const : i64  12
	v29 = add : i64 v27, v28
}
