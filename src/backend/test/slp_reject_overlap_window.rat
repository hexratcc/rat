@name slp: load range straddling the store window stays scalar (store-forward trap)
@passes slp

@input
func t(ptr) -> void {
	v0 = start : (ctrl, mem, ptr)
	v1 = stop : ctrl v20
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "a" of v0
	v5 = const : i64  4
	v6 = const : i64  8
	v7 = const : i64  12
	v8 = const : i64  16
	v9 = const : i64  20
	v10 = const : i64  24
	v11 = add : ptr v4, v5
	v12 = add : ptr v4, v6
	v13 = add : ptr v4, v7
	v14 = add : ptr v4, v8
	v15 = add : ptr v4, v9
	v16 = add : ptr v4, v10
	v30 = load : i32 v2, v3, v13
	v31 = load : i32 v2, v3, v14
	v32 = load : i32 v2, v3, v15
	v33 = load : i32 v2, v3, v16
	v40 = load : i32 v2, v3, v4
	v41 = load : i32 v2, v3, v11
	v42 = load : i32 v2, v3, v12
	v43 = load : i32 v2, v3, v13
	v50 = xor : i32 v40, v30
	v51 = xor : i32 v41, v31
	v52 = xor : i32 v42, v32
	v53 = xor : i32 v43, v33
	v60 = store : mem v2, v3, v4, v50
	v61 = store : mem v2, v60, v11, v51
	v62 = store : mem v2, v61, v12, v52
	v63 = store : mem v2, v62, v13, v53
	v20 = return : ctrl v2, v63
}

