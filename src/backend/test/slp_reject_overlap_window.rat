	v9 = const : i64  20
	v10 = const : i64  24
	v11 = add : ptr v4, v5
	v12 = add : ptr v4, v6
	v13 = add : ptr v4, v7
	v14 = add : ptr v4, v8
	v15 = add : ptr v4, v9
	v16 = add : ptr v4, v10
	v30 = load : i32 v2, v3, v13
	v31 = load : i32 v2, v3, v14
	v32 = load : i32 v2, v3, v15
	v33 = load : i32 v2, v3, v16
	v40 = load : i32 v2, v3, v4
	v41 = load : i32 v2, v3, v11
