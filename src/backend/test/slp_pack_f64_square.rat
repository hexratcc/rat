@name slp: two adjacent f64 lanes pack into a mulpd-shaped graph
@passes slp

@input
func t(ptr, ptr) -> void {
	v0 = start : (ctrl, mem, ptr, ptr)
	v1 = stop : ctrl v20
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "dst" of v0
	v5 = proj : ptr  #3 "src" of v0
	v6 = const : i64  8
	v7 = add : ptr v4, v6
	v8 = add : ptr v5, v6
	v9 = load : f64 v2, v3, v5
	v10 = load : f64 v2, v3, v8
	v11 = fmul : f64 v9, v9
	v12 = fmul : f64 v10, v10
	v13 = store : mem v2, v3, v4, v11
	v14 = store : mem v2, v13, v7, v12
	v20 = return : ctrl v2, v14
}

@expect
func t(ptr, ptr) -> void {
  v0 = start : (ctrl, mem, ptr, ptr)
  v1 = stop : ctrl v15
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "dst" of v0
  v5 = proj : ptr  #3 "src" of v0
  v15 = return : ctrl v2, v18
  v16 = load : <2 x f64> v2, v3, v5
  v17 = fmul : <2 x f64> v16, v16
  v18 = store : mem v2, v3, v4, v17
}
