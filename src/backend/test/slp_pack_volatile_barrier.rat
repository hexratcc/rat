@name slp: a volatile store ends the store chain but does not stop packing the run before it
@passes slp

@input
func t(ptr, ptr, ptr, i32) -> void {
	v0 = start : (ctrl, mem, ptr, ptr, ptr, i32)
	v1 = stop : ctrl v20
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "a" of v0
	v5 = proj : ptr  #3 "b" of v0
	v33 = proj : ptr  #4 "v" of v0
	v6 = proj : i32  #5 "k" of v0
	v7 = const : i64  4
	v8 = const : i64  8
	v9 = const : i64  12
	v10 = add : ptr v4, v7
	v11 = add : ptr v4, v8
	v12 = add : ptr v4, v9
	v13 = load : i32 v2, v3, v5
	v30 = add : ptr v5, v7
	v31 = add : ptr v5, v8
	v32 = add : ptr v5, v9
	v14 = load : i32 v2, v3, v30
	v15 = load : i32 v2, v3, v31
	v16 = load : i32 v2, v3, v32
	v21 = add : i32 v13, v6
	v22 = add : i32 v14, v6
	v23 = add : i32 v15, v6
	v24 = add : i32 v16, v6
	v25 = store : mem v2, v3, v4, v21
	v26 = store : mem v2, v25, v10, v22
	v27 = store : mem v2, v26, v11, v23
	v28 = store : mem v2, v27, v12, v24
	v29 = store : mem  volatile v2, v28, v33, v6
	v20 = return : ctrl v2, v29
}

@expect
func t(ptr, ptr, ptr, i32) -> void {
  v0 = start : (ctrl, mem, ptr, ptr, ptr, i32)
  v1 = stop : ctrl v30
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "a" of v0
  v5 = proj : ptr  #3 "b" of v0
  v6 = proj : ptr  #4 "v" of v0
  v7 = proj : i32  #5 "k" of v0
  v29 = store : mem  volatile v2, v34, v6, v7
  v30 = return : ctrl v2, v29
  v31 = load : <4 x i32> v2, v3, v5
  v32 = splat : <4 x i32> v7
  v33 = add : <4 x i32> v31, v32
  v34 = store : mem v2, v3, v4, v33
}
