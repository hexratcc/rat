@name slp: pointer stores pack as integer lanes
@passes slp

@input
var a : [2 x ptr] = ""
var b : [2 x ptr] = ""

func t() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v20
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = global : ptr  "a"
	v5 = global : ptr  "b"
	v6 = const : i64  8
	v7 = add : ptr v4, v6
	v8 = add : ptr v5, v6
	v9 = load : ptr v2, v3, v5
	v10 = store : mem v2, v3, v4, v9
	v11 = load : ptr v2, v10, v8
	v12 = store : mem v2, v10, v7, v11
	v20 = return : ctrl v2, v12
}

@expect
var a : [2 x ptr] = ""
var b : [2 x ptr] = ""

func t() -> void {
  v0 = start : (ctrl, mem)
  v1 = stop : ctrl v8
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = global : ptr  "a"
  v5 = global : ptr  "b"
  v6 = load : <2 x ptr> v2, v3, v5
  v7 = store : mem v2, v3, v4, v6
  v8 = return : ctrl v2, v7
}
