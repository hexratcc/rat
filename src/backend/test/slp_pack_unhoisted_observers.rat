@expect
var a : [512 x i32] = ""
var c : [4 x i32] = ""

func t(i64) -> void {
	v0 = start : (ctrl, mem, i64)
	v1 = stop : ctrl v47
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : i64  #2 "x" of v0
	v5 = global : ptr  "c"
