	v78 = load : i32 v2, v3, v71
	v79 = add : i32 v78, v78
	v80 = store : mem v2, v3, v5, v79
	v81 = load : i32 v2, v80, v72
	v82 = add : i32 v81, v81
	v83 = store : mem v2, v80, v75, v82
	v84 = load : i32 v2, v83, v73
	v85 = add : i32 v84, v84
	v86 = store : mem v2, v83, v76, v85
	v87 = load : i32 v2, v86, v74
	v88 = add : i32 v87, v87
