@name slp: observers whose address cone is too big to hoist are re-read under a static fact, no guard
@passes slp

@input
var a : [512 x i32] = ""
var c : [4 x i32] = ""

func t(i64) -> void {
	v0 = start : (ctrl, mem, i64)
	v1 = stop : ctrl v90
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : i64  #2 "x" of v0
	v5 = global : ptr  "c"
	v6 = global : ptr  "a"
	v7 = const : i64  4
	v8 = const : i64  8
	v9 = const : i64  12
	v10 = xor : i64 v4, v4
	v11 = xor : i64 v10, v4
	v12 = xor : i64 v11, v4
	v13 = xor : i64 v12, v4
	v14 = xor : i64 v13, v4
	v15 = xor : i64 v14, v4
	v16 = xor : i64 v15, v4
	v17 = xor : i64 v16, v4
	v18 = xor : i64 v17, v4
	v19 = xor : i64 v18, v4
	v20 = xor : i64 v19, v4
	v21 = xor : i64 v20, v4
	v22 = xor : i64 v21, v4
	v23 = xor : i64 v22, v4
