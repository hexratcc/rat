	v31 = xor : i64 v30, v4
	v32 = xor : i64 v31, v4
	v33 = xor : i64 v32, v4
	v34 = xor : i64 v33, v4
	v35 = xor : i64 v34, v4
	v36 = xor : i64 v35, v4
	v37 = xor : i64 v36, v4
	v38 = xor : i64 v37, v4
	v39 = xor : i64 v38, v4
	v40 = xor : i64 v39, v4
	v41 = xor : i64 v40, v4
	v42 = xor : i64 v41, v4
