	v57 = xor : i64 v56, v4
	v58 = xor : i64 v57, v4
	v59 = xor : i64 v58, v4
	v60 = xor : i64 v59, v4
	v61 = xor : i64 v60, v4
	v62 = xor : i64 v61, v4
	v63 = xor : i64 v62, v4
	v64 = xor : i64 v63, v4
	v65 = xor : i64 v64, v4
	v66 = xor : i64 v65, v4
	v67 = xor : i64 v66, v4
	v68 = xor : i64 v67, v4
	v69 = xor : i64 v68, v4
	v70 = mul : i64 v69, v7
	v71 = add : ptr v6, v70
	v72 = add : ptr v71, v7
	v73 = add : ptr v71, v8
	v74 = add : ptr v71, v9
	v75 = add : ptr v5, v7
