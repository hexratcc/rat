	v35 = xor : <2 x i64> v34, v8
	v36 = xor : <2 x i64> v35, v8
	v37 = xor : <2 x i64> v36, v8
	v38 = shuffle : <2 x i64>  #1 v37, v37
	v39 = xor : <2 x i64> v37, v38
	v40 = extract : i64  #0 v39
	v41 = xor : i64 v40, v4
	v42 = mul : i64 v41, v7
	v43 = add : ptr v6, v42
	v44 = load : <4 x i32> v2, v3, v43
