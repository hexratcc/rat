@name slp: a guarded run must not sink a pre-existing shared load into the speculative arm
@passes slp

@input
func t(ptr, ptr, ptr) -> void {
	v0 = start : (ctrl, mem, ptr, ptr, ptr)
	v1 = stop : ctrl v200
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "c" of v0
	v5 = proj : ptr  #3 "a" of v0
	v6 = proj : ptr  #4 "b" of v0
	v7 = load : i32 v2, v3, v6
	v10 = load : i32 v2, v3, v5
	v11 = add : i32 v10, v7
	v12 = store : mem v2, v3, v4, v11
	v13 = const : i64  4
	v14 = add : ptr v4, v13
	v15 = add : ptr v5, v13
	v16 = load : i32 v2, v12, v15
	v17 = add : i32 v16, v7
	v18 = store : mem v2, v12, v14, v17
	v19 = const : i64  8
	v20 = add : ptr v4, v19
	v21 = add : ptr v5, v19
	v22 = load : i32 v2, v18, v21
	v23 = add : i32 v22, v7
	v24 = store : mem v2, v18, v20, v23
	v25 = const : i64  12
	v26 = add : ptr v4, v25
	v27 = add : ptr v5, v25
	v28 = load : i32 v2, v24, v27
	v29 = add : i32 v28, v7
	v30 = store : mem v2, v24, v26, v29
	v31 = const : i64  16
	v32 = add : ptr v4, v31
	v33 = add : ptr v5, v31
	v34 = load : i32 v2, v30, v33
	v35 = add : i32 v34, v7
	v36 = store : mem v2, v30, v32, v35
	v37 = const : i64  20
	v38 = add : ptr v4, v37
	v39 = add : ptr v5, v37
	v40 = load : i32 v2, v36, v39
	v41 = add : i32 v40, v7
	v42 = store : mem v2, v36, v38, v41
	v43 = const : i64  24
	v44 = add : ptr v4, v43
	v45 = add : ptr v5, v43
	v46 = load : i32 v2, v42, v45
	v47 = add : i32 v46, v7
	v48 = store : mem v2, v42, v44, v47
	v49 = const : i64  28
	v50 = add : ptr v4, v49
	v51 = add : ptr v5, v49
	v52 = load : i32 v2, v48, v51
	v53 = add : i32 v52, v7
	v54 = store : mem v2, v48, v50, v53
	v200 = return : ctrl v2, v54
}

