  v0 = start : (ctrl, mem, ptr, i32, i32, ptr)
  v1 = stop : ctrl v21
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "arg0" of v0
  v5 = proj : i32  #3 "arg1" of v0
  v6 = proj : i32  #4 "arg2" of v0
  v7 = proj : ptr  #5 "arg3" of v0
  v8 = const : i32  0
  v9 = ne : i1 v6, v8
  v10 = if : (ctrl, ctrl) v2, v9
  v11 = proj : ctrl  #0 "then" of v10
  v12 = proj : ctrl  #1 "else" of v10
  v13 = const : i32  1
  v14 = add : i32  nsw v5, v13
  v15 = sext : i64 v14
  v16 = const : i32  3
  v17 = sub : i32  nsw v5, v16
  v18 = sext : i64 v17
  v19 = region : ctrl v11, v12
  v20 = phi : mem v19, v28, v30
