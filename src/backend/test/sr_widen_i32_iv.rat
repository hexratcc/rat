@name strengthreduce: a counted i32 IV read through sext becomes an i64 IV
@passes strengthreduce

@input
var a : [1024 x i32] = ""
var b : [1024 x i32] = ""

func f() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v29
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = const : i32  0
	v5 = region : ctrl  loop v2, v10
	v6 = phi : i32 v5, v4, v28
	v7 = const : i32  1000
	v8 = slt : i1 v6, v7
	v9 = if : (ctrl, ctrl) v5, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "a"
	v13 = sext : i64 v6
	v14 = const : i64  2
	v15 = shl : i64 v13, v14
	v16 = add : ptr v12, v15
	v17 = global : ptr  "b"
	v18 = const : i32  1
	v19 = add : i32 v6, v18
	v20 = sext : i64 v19
	v21 = shl : i64 v20, v14
	v22 = add : ptr v17, v21
	v23 = phi : mem v5, v3, v25
	v24 = load : i32 v10, v23, v22
	v25 = store : mem v10, v23, v16, v24
	v26 = const : i32  2
	v28 = add : i32 v6, v26
	v29 = return : ctrl v11, v23
}

@expect
var a : [1024 x i32] = ""
var b : [1024 x i32] = ""

func f() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v28
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v5 = region : ctrl  loop v2, v10
	v9 = if : (ctrl, ctrl) v5, v34
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "a"
	v14 = const : i64  2
	v15 = shl : i64 v30, v14
	v16 = add : ptr v12, v15
	v17 = global : ptr  "b"
	v21 = shl : i64 v36, v14
	v22 = add : ptr v17, v21
	v23 = phi : mem v5, v3, v25
	v24 = load : i32 v10, v23, v22
	v25 = store : mem v10, v23, v16, v24
	v28 = return : ctrl v11, v23
	v29 = const : i64  0
	v30 = phi : i64 v5, v29, v32
	v31 = const : i64  2
	v32 = add : i64 v30, v31
	v33 = const : i64  1000
	v34 = slt : i1 v30, v33
	v35 = const : i64  1
	v36 = add : i64 v30, v35
}
