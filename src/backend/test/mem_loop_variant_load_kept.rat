@name memoryopt: a loop-variant load keeps the loop state (p[1] of one iteration is p[0] of the next)
@passes memoryopt

@input
var a : [1024 x i32] = ""

func f() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v24
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = const : i64  0
	v5 = region : ctrl  loop v2, v10
	v6 = phi : i64 v5, v4, v23
	v7 = const : i64  1000
	v8 = slt : i1 v6, v7
	v9 = if : (ctrl, ctrl) v5, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "a"
	v13 = const : i64  2
	v14 = shl : i64 v6, v13
	v15 = add : ptr v12, v14
	v16 = const : i64  4
	v17 = add : ptr v15, v16
	v18 = phi : mem v5, v3, v21
	v19 = load : i32 v10, v18, v15
	v20 = const : i32  1
	v25 = add : i32 v19, v20
	v21 = store : mem v10, v18, v17, v25
	v22 = const : i64  1
	v23 = add : i64 v6, v22
	v24 = return : ctrl v11, v18
}

@expect
var a : [1024 x i32] = ""

func f() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v25
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = const : i64  0
	v5 = region : ctrl  loop v2, v10
	v6 = phi : i64 v5, v4, v24
	v7 = const : i64  1000
	v8 = slt : i1 v6, v7
	v9 = if : (ctrl, ctrl) v5, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "a"
	v13 = const : i64  2
	v14 = shl : i64 v6, v13
	v15 = add : ptr v12, v14
	v16 = const : i64  4
	v17 = add : ptr v15, v16
	v18 = phi : mem v5, v3, v22
	v19 = load : i32 v10, v18, v15
	v20 = const : i32  1
	v21 = add : i32 v19, v20
	v22 = store : mem v10, v18, v17, v21
	v23 = const : i64  1
	v24 = add : i64 v6, v23
	v25 = return : ctrl v11, v18
}
