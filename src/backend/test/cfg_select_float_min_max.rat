@name simplifycfg: a float min or max diamond becomes a select when stored at its merge or chained, a returned one, a >= one, one an fmul reads and one a call separates stay
@passes simplifycfg verify

@input
func fmax(f32, f32) -> f32 {
	v0 = start : (ctrl, mem, f32, f32)
	v1 = stop : ctrl v15
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : f32  #2 "arg0" of v0
	v5 = proj : f32  #3 "arg1" of v0
	v8 = fgt : i1 v4, v5
	v9 = if : (ctrl, ctrl) v2, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = region : ctrl v10, v11
	v13 = phi : f32 v12, v4, v5
	v15 = return : ctrl v12, v3, v13
}

func fge(f32, f32) -> f32 {
	v0 = start : (ctrl, mem, f32, f32)
	v1 = stop : ctrl v15
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : f32  #2 "arg0" of v0
	v5 = proj : f32  #3 "arg1" of v0
	v8 = fge : i1 v4, v5
	v9 = if : (ctrl, ctrl) v2, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = region : ctrl v10, v11
	v13 = phi : f32 v12, v4, v5
	v15 = return : ctrl v12, v3, v13
}

func fmaxmul(f32, f32) -> f32 {
	v0 = start : (ctrl, mem, f32, f32)
	v1 = stop : ctrl v15
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : f32  #2 "arg0" of v0
	v5 = proj : f32  #3 "arg1" of v0
	v8 = fgt : i1 v4, v5
	v9 = if : (ctrl, ctrl) v2, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = region : ctrl v10, v11
	v13 = phi : f32 v12, v4, v5
	v14 = fmul : f32 v13, v13
	v15 = return : ctrl v12, v3, v14
}

func fstore(ptr, f64, f64) -> void {
	v0 = start : (ctrl, mem, ptr, f64, f64)
	v1 = stop : ctrl v15
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "p" of v0
	v5 = proj : f64  #3 "a" of v0
	v6 = proj : f64  #4 "b" of v0
	v8 = flt : i1 v5, v6
	v9 = if : (ctrl, ctrl) v2, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = region : ctrl v10, v11
	v13 = phi : f64 v12, v5, v6
	v14 = store : mem v12, v3, v4, v13
	v15 = return : ctrl v12, v14
}

