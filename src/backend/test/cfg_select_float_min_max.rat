	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : f32  #2 "a" of v0
	v5 = proj : f32  #3 "b" of v0
	v6 = proj : f32  #4 "c" of v0
	v8 = fgt : i1 v4, v5
	v9 = if : (ctrl, ctrl) v2, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = region : ctrl v10, v11
	v13 = phi : f32 v12, v4, v5
	v14 = call : (ctrl, mem) "g" v12, v3
	v15 = proj : ctrl  #0 "ctrl" of v14
	v16 = proj : mem  #1 "mem" of v14
	v18 = fgt : i1 v13, v6
	v19 = if : (ctrl, ctrl) v15, v18
	v20 = proj : ctrl  #0 "then" of v19
	v21 = proj : ctrl  #1 "else" of v19
	v22 = region : ctrl v20, v21
	v23 = phi : f32 v22, v13, v6
	v25 = return : ctrl v22, v16, v23
}

