@name strengthreduce: an i32 IV with a parameter bound is not widened (its step may wrap)
@passes strengthreduce

@input
var a : [1024 x i32] = ""

func f(i32) -> void {
	v0 = start : (ctrl, mem, i32)
	v1 = stop : ctrl v21
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : i32  #2 "arg0" of v0
	v5 = const : i32  0
	v6 = region : ctrl  loop v2, v10
	v7 = phi : i32 v6, v5, v20
	v8 = slt : i1 v7, v4
	v9 = if : (ctrl, ctrl) v6, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "a"
	v13 = sext : i64 v7
	v14 = const : i64  2
	v15 = shl : i64 v13, v14
	v16 = add : ptr v12, v15
	v17 = phi : mem v6, v3, v18
	v18 = store : mem v10, v17, v16, v7
	v19 = const : i32  2
	v20 = add : i32 v7, v19
	v21 = return : ctrl v11, v17
}

@expect
var a : [1024 x i32] = ""

func f(i32) -> void {
	v0 = start : (ctrl, mem, i32)
	v1 = stop : ctrl v21
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : i32  #2 "arg0" of v0
	v5 = const : i32  0
	v6 = region : ctrl  loop v2, v10
	v7 = phi : i32 v6, v5, v20
	v8 = slt : i1 v7, v4
	v9 = if : (ctrl, ctrl) v6, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "a"
	v13 = sext : i64 v7
	v14 = const : i64  2
	v15 = shl : i64 v13, v14
	v16 = add : ptr v12, v15
	v17 = phi : mem v6, v3, v18
	v18 = store : mem v10, v17, v16, v7
	v19 = const : i32  2
	v20 = add : i32 v7, v19
	v21 = return : ctrl v11, v17
}
