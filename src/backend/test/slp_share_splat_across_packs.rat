@name slp: two windows of one scalar share its splat
@passes slp

@input
func t(ptr restrict, i32) -> void {
	v0 = start : (ctrl, mem, ptr, i32)
	v1 = stop : ctrl v40
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "p" of v0
	v5 = proj : i32  #3 "x" of v0
	v6 = const : i64  4
	v7 = const : i64  8
	v8 = const : i64  12
	v9 = const : i64  16
	v10 = const : i64  20
	v11 = const : i64  24
	v12 = const : i64  28
	v13 = add : ptr v4, v6
	v14 = add : ptr v4, v7
	v15 = add : ptr v4, v8
	v16 = add : ptr v4, v9
	v17 = add : ptr v4, v10
	v18 = add : ptr v4, v11
	v19 = add : ptr v4, v12
	v20 = store : mem v2, v3, v4, v5
	v21 = store : mem v2, v20, v13, v5
	v22 = store : mem v2, v21, v14, v5
	v23 = store : mem v2, v22, v15, v5
	v24 = store : mem v2, v23, v16, v5
	v25 = store : mem v2, v24, v17, v5
	v26 = store : mem v2, v25, v18, v5
	v27 = store : mem v2, v26, v19, v5
	v40 = return : ctrl v2, v27
}

@expect
func t(ptr restrict, i32) -> void {
  v0 = start : (ctrl, mem, ptr, i32)
  v1 = stop : ctrl v28
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "p" of v0
  v5 = proj : i32  #3 "x" of v0
  v9 = const : i64  16
  v16 = add : ptr v4, v9
  v20 = store : mem v2, v3, v4, v29
  v24 = store : mem v2, v20, v16, v29
  v28 = return : ctrl v2, v24
  v29 = splat : <4 x i32> v5
}
