@name slp: a four-term i32 dot product packs as one vector with a horizontal finish, an i64 xor chain as two-lane xors
@passes slp

@input
func dot4(ptr restrict, ptr restrict) -> i32 {
	v0 = start : (ctrl, mem, ptr, ptr)
	v1 = stop : ctrl v99
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "a" of v0
	v5 = proj : ptr  #3 "b" of v0
	v6 = const : i64  4
	v7 = const : i64  8
	v8 = const : i64  12
	v13 = add : ptr v4, v6
	v14 = add : ptr v4, v7
	v15 = add : ptr v4, v8
	v20 = add : ptr v5, v6
	v21 = add : ptr v5, v7
	v22 = add : ptr v5, v8
	v30 = load : i32 v2, v3, v4
	v31 = load : i32 v2, v3, v13
	v32 = load : i32 v2, v3, v14
	v33 = load : i32 v2, v3, v15
	v40 = load : i32 v2, v3, v5
	v41 = load : i32 v2, v3, v20
	v42 = load : i32 v2, v3, v21
	v43 = load : i32 v2, v3, v22
	v50 = mul : i32 v30, v40
	v51 = mul : i32 v31, v41
	v52 = mul : i32 v32, v42
	v53 = mul : i32 v33, v43
	v60 = add : i32 v50, v51
	v61 = add : i32 v60, v52
	v62 = add : i32 v61, v53
	v99 = return : ctrl v2, v3, v62
}

func xor8(ptr restrict) -> i64 {
	v0 = start : (ctrl, mem, ptr)
	v1 = stop : ctrl v99
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "a" of v0
	v6 = const : i64  8
	v7 = const : i64  16
	v8 = const : i64  24
	v9 = const : i64  32
	v10 = const : i64  40
	v11 = const : i64  48
	v12 = const : i64  56
	v13 = add : ptr v4, v6
	v14 = add : ptr v4, v7
	v15 = add : ptr v4, v8
	v16 = add : ptr v4, v9
	v17 = add : ptr v4, v10
	v18 = add : ptr v4, v11
	v19 = add : ptr v4, v12
	v30 = load : i64 v2, v3, v4
	v31 = load : i64 v2, v3, v13
	v32 = load : i64 v2, v3, v14
	v33 = load : i64 v2, v3, v15
	v34 = load : i64 v2, v3, v16
	v35 = load : i64 v2, v3, v17
	v36 = load : i64 v2, v3, v18
	v37 = load : i64 v2, v3, v19
	v40 = xor : i64 v30, v31
	v41 = xor : i64 v40, v32
	v42 = xor : i64 v41, v33
	v43 = xor : i64 v42, v34
	v44 = xor : i64 v43, v35
	v45 = xor : i64 v44, v36
	v46 = xor : i64 v45, v37
	v99 = return : ctrl v2, v3, v46
}

@expect
func dot4(ptr restrict, ptr restrict) -> i32 {
  v0 = start : (ctrl, mem, ptr, ptr)
  v1 = stop : ctrl v30
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "a" of v0
  v5 = proj : ptr  #3 "b" of v0
  v30 = return : ctrl v2, v3, v38
  v31 = load : <4 x i32> v2, v3, v4
  v32 = load : <4 x i32> v2, v3, v5
  v33 = mul : <4 x i32> v31, v32
  v34 = shuffle : <4 x i32>  #4146 v33, v33
  v35 = add : <4 x i32> v33, v34
  v36 = shuffle : <4 x i32>  #8961 v35, v35
  v37 = add : <4 x i32> v35, v36
  v38 = extract : i32  #0 v37
}

func xor8(ptr restrict) -> i64 {
  v0 = start : (ctrl, mem, ptr)
  v1 = stop : ctrl v34
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "a" of v0
  v34 = return : ctrl v2, v3, v50
  v35 = load : <2 x i64> v2, v3, v4
  v36 = const : i64  16
  v37 = add : ptr v4, v36
  v38 = load : <2 x i64> v2, v3, v37
  v39 = const : i64  32
  v40 = add : ptr v4, v39
  v41 = load : <2 x i64> v2, v3, v40
  v42 = const : i64  48
  v43 = add : ptr v4, v42
  v44 = load : <2 x i64> v2, v3, v43
  v45 = xor : <2 x i64> v35, v38
  v46 = xor : <2 x i64> v45, v41
  v47 = xor : <2 x i64> v46, v44
  v48 = shuffle : <2 x i64>  #1 v47, v47
  v49 = xor : <2 x i64> v47, v48
  v50 = extract : i64  #0 v49
}
