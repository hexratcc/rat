@name slp: loads copied to two places count as dead, both copies pack and share a wide load
@passes slp

@input
var s : [2 x i64] = ""

func t(ptr restrict, ptr restrict) -> void {
	v0 = start : (ctrl, mem, ptr, ptr)
	v1 = stop : ctrl v30
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "p" of v0
	v5 = proj : ptr  #3 "q" of v0
	v6 = global : ptr  "s"
	v7 = const : i64  8
	v8 = add : ptr v6, v7
	v9 = add : ptr v4, v7
	v10 = add : ptr v5, v7
	v11 = load : i64 v2, v3, v6
	v12 = load : i64 v2, v3, v8
	v13 = store : mem v2, v3, v4, v11
	v14 = store : mem v2, v13, v9, v12
	v15 = store : mem v2, v14, v5, v11
	v16 = store : mem v2, v15, v10, v12
	v30 = return : ctrl v2, v16
}

@expect
var s : [2 x i64] = ""

func t(ptr restrict, ptr restrict) -> void {
  v0 = start : (ctrl, mem, ptr, ptr)
  v1 = stop : ctrl v17
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "p" of v0
  v5 = proj : ptr  #3 "q" of v0
  v6 = global : ptr  "s"
  v13 = store : mem v2, v3, v4, v18
  v15 = store : mem v2, v13, v5, v18
  v17 = return : ctrl v2, v15
  v18 = load : <2 x i64> v2, v3, v6
}
