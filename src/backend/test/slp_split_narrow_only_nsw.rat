func flagged(ptr, i32, i32) -> void {
  v0 = start : (ctrl, mem, ptr, i32, i32)
  v1 = stop : ctrl v30
  v2 = proj : ctrl  #0 "ctrl" of v0
  v3 = proj : mem  #1 "mem" of v0
  v4 = proj : ptr  #2 "p" of v0
  v5 = proj : i32  #3 "u" of v0
  v6 = proj : i32  #4 "v" of v0
  v7 = sext : i64 v5
  v8 = const : i64  2
  v9 = shl : i64 v7, v8
  v10 = add : ptr v4, v9
  v30 = return : ctrl v2, v33
  v32 = splat : <4 x i32> v6
  v33 = store : mem v2, v3, v10, v32
}
