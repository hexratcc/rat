@name memoryopt: a load of an object the loop stores keeps the loop state, so SLP groups its lanes
@passes memoryopt

@input
var g : [8 x i32] = ""

func f() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v20
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = const : i64  0
	v5 = region : ctrl  loop v2, v10
	v6 = phi : i64 v5, v4, v19
	v7 = const : i64  1000
	v8 = slt : i1 v6, v7
	v9 = if : (ctrl, ctrl) v5, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "g"
	v13 = const : i64  4
	v14 = add : ptr v12, v13
	v15 = phi : mem v5, v3, v17
	v16 = load : i32 v10, v15, v12
	v17 = store : mem v10, v15, v14, v16
	v18 = const : i64  1
	v19 = add : i64 v6, v18
	v20 = return : ctrl v11, v15
}

@expect
var g : [8 x i32] = ""

func f() -> void {
	v0 = start : (ctrl, mem)
	v1 = stop : ctrl v20
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = const : i64  0
	v5 = region : ctrl  loop v2, v10
	v6 = phi : i64 v5, v4, v19
	v7 = const : i64  1000
	v8 = slt : i1 v6, v7
	v9 = if : (ctrl, ctrl) v5, v8
	v10 = proj : ctrl  #0 "then" of v9
	v11 = proj : ctrl  #1 "else" of v9
	v12 = global : ptr  "g"
	v13 = const : i64  4
	v14 = add : ptr v12, v13
	v15 = phi : mem v5, v3, v17
	v16 = load : i32 v10, v15, v12
	v17 = store : mem v10, v15, v14, v16
	v18 = const : i64  1
	v19 = add : i64 v6, v18
	v20 = return : ctrl v11, v15
}
