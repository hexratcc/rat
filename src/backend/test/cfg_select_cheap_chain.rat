@name simplifycfg: a cheap arm computation still converts to a select
@passes simplifycfg

@input
func t(i32, i32) -> i16 {
	v0 = start : (ctrl, mem, i32, i32)
	v1 = stop : ctrl v20
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : i32  #2 "arg0" of v0
	v5 = proj : i32  #3 "arg1" of v0
	v6 = const : i32  7
	v7 = slt : i1 v4, v5
	v8 = if : (ctrl, ctrl) v2, v7
	v9 = proj : ctrl  #0 "then" of v8
	v10 = proj : ctrl  #1 "else" of v8
	v11 = region : ctrl v9, v10
	v12 = xor : i32 v4, v6
	v13 = trunc : i16 v12
	v14 = trunc : i16 v5
	v15 = phi : i16 v11, v13, v14
	v20 = return : ctrl v11, v3, v15
}

@expect
func t(i32, i32) -> i16 {
	v0 = start : (ctrl, mem, i32, i32)
	v1 = stop : ctrl v16
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : i32  #2 "arg0" of v0
	v5 = proj : i32  #3 "arg1" of v0
	v6 = const : i32  7
	v7 = slt : i1 v4, v5
	v12 = xor : i32 v4, v6
	v13 = trunc : i16 v12
	v14 = trunc : i16 v5
	v16 = return : ctrl v2, v3, v17
	v17 = select : i16 v7, v13, v14
}
