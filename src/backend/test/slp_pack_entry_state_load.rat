@name slp: lane loads of a state no writer of their block reads pack as one vector, the scheduler keeps it above the store
@passes slp

@input
func t(ptr, ptr, i1) -> void {
	v0 = start : (ctrl, mem, ptr, ptr, i1)
	v1 = stop : ctrl v60
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "a" of v0
	v5 = proj : ptr  #3 "b" of v0
	v6 = proj : i1  #4 "c" of v0
	v7 = if : (ctrl, ctrl) v2, v6
	v8 = proj : ctrl  #0 "then" of v7
	v9 = proj : ctrl  #1 "else" of v7
	v10 = region : ctrl v8, v9
	v11 = phi : mem v10, v3, v3
	v12 = const : i64  4
	v13 = const : i64  8
	v14 = const : i64  12
	v15 = add : ptr v4, v12
	v16 = add : ptr v4, v13
	v17 = add : ptr v4, v14
	v18 = add : ptr v5, v12
	v19 = add : ptr v5, v13
	v20 = add : ptr v5, v14
	v21 = load : i32 v10, v3, v4
	v22 = load : i32 v10, v3, v15
	v23 = load : i32 v10, v3, v16
	v24 = load : i32 v10, v3, v17
	v25 = const : i32  7
	v26 = store : mem v10, v11, v4, v25
	v27 = store : mem v10, v26, v5, v21
	v28 = store : mem v10, v27, v18, v22
	v29 = store : mem v10, v28, v19, v23
	v30 = store : mem v10, v29, v20, v24
	v60 = return : ctrl v10, v30
}

@expect
func t(ptr, ptr, i1) -> void {
	v0 = start : (ctrl, mem, ptr, ptr, i1)
	v1 = stop : ctrl v16
	v2 = proj : ctrl  #0 "ctrl" of v0
	v3 = proj : mem  #1 "mem" of v0
	v4 = proj : ptr  #2 "a" of v0
	v5 = proj : ptr  #3 "b" of v0
	v6 = proj : i1  #4 "c" of v0
	v7 = if : (ctrl, ctrl) v2, v6
	v8 = proj : ctrl  #0 "then" of v7
	v9 = proj : ctrl  #1 "else" of v7
	v10 = region : ctrl v8, v9
	v11 = phi : mem v10, v3, v3
	v12 = const : i32  7
	v13 = store : mem v10, v11, v4, v12
	v14 = load : <4 x i32> v10, v3, v4
	v15 = store : mem v10, v13, v5, v14
	v16 = return : ctrl v10, v15
}
