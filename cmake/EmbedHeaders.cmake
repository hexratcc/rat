if(NOT HDR_DIR OR NOT OUT)
	message(FATAL_ERROR "EmbedHeaders.cmake needs -DHDR_DIR=... and -DOUT=...")
endif()

file(GLOB_RECURSE RAT_HDR_FILES RELATIVE "${HDR_DIR}" "${HDR_DIR}/*.h")
list(SORT RAT_HDR_FILES)

set(RAT_HDR_OUT "// generated by cmake/EmbedHeaders.cmake from cc/headers/ - do not edit\n")
foreach(f IN LISTS RAT_HDR_FILES)
	file(READ "${HDR_DIR}/${f}" RAT_HDR_TEXT)
	if(RAT_HDR_TEXT MATCHES [[\)RATHDR"]])
		message(FATAL_ERROR "cc/headers/${f} contains the raw-string delimiter )RATHDR\"")
	endif()
	string(APPEND RAT_HDR_OUT "{\"${f}\", R\"RATHDR(${RAT_HDR_TEXT})RATHDR\"},\n")
endforeach()

# write only on change to avoid needless rebuilds
if(EXISTS "${OUT}")
	file(READ "${OUT}" RAT_HDR_OLD)
else()
	set(RAT_HDR_OLD "")
endif()
if(NOT RAT_HDR_OUT STREQUAL RAT_HDR_OLD)
	file(WRITE "${OUT}" "${RAT_HDR_OUT}")
endif()
